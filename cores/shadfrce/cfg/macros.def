CORENAME=SHADFRCE
GAMETOP=jtshadfrce_game_sdram

JTFRAME_STEREO

JTFRAME_COLORW=8
JTFRAME_WIDTH=320
JTFRAME_HEIGHT=240

JTFRAME_BUTTONS=6
JTFRAME_JOY_DULR

JTFRAME_BA1_START=0x100000
JTFRAME_BA2_START=0x300000
SND_START=0x400000
PCM_START=0x410000
CHAR_START=0x490000
OBJ4_START=0x4B0000
JTFRAME_BA3_START=0x6B0000

[mister]
# CRT Adjust (https://github.com/rmonic79/MiSTer-CRT-Adjust): analog H-Size,
# H-Position and V-Shift from the OSD. Needs jtframe-patches/crt_adjust.patch
JTFRAME_CRT_ADJUST
JTFRAME_CRT_ADJUST_HTOTAL=448
JTFRAME_CRT_ADJUST_VTOTAL=272
# H-Position mechanism: 1 = content shift (320 px active on a 448 px line)
JTFRAME_CRT_ADJUST_HPOS=1
# read period = (BASE+H-Size)/INC clocks; 48 MHz / 7 MHz = 48/7
JTFRAME_CRT_ADJUST_INC=7
JTFRAME_CRT_ADJUST_BASE=48
JTFRAME_ARX=4
JTFRAME_ARY=3
JTFRAME_OSD_NOLOGO
